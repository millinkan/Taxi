# Secrets for Kamal, read from your environment or password manager at deploy
# time. NEVER put literal secret values in this file; it is committed.
#
# Example with environment variables exported in your shell:
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)
INTERNAL_API_TOKEN=$INTERNAL_API_TOKEN
TWILIO_ACCOUNT_SID=$TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=$TWILIO_AUTH_TOKEN
GOOGLE_MAPS_API_KEY=$GOOGLE_MAPS_API_KEY
SMTP_USERNAME=$SMTP_USERNAME
SMTP_PASSWORD=$SMTP_PASSWORD
# Hetzner Object Storage credentials for the Litestream backup accessory
LITESTREAM_ACCESS_KEY_ID=$LITESTREAM_ACCESS_KEY_ID
LITESTREAM_SECRET_ACCESS_KEY=$LITESTREAM_SECRET_ACCESS_KEY

