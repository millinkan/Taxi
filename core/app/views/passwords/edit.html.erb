<% content_for :title, t("auth.new_password") %>
<div class="card">
  <h1><%= t("auth.new_password") %></h1>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="field">
      <%= form.label :password, t("auth.password") %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72 %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, t("auth.password_confirmation") %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <%= form.submit t("auth.save"), class: "btn btn--primary btn--block" %>
  <% end %>
</div>
