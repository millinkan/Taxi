<% content_for :title, t("settings.nav.vehicles") %>
<h1><%= t("settings.title") %></h1>
<%= render "settings/nav" %>

<div class="page-head">
  <p class="muted" style="margin: 0;"><%= t("settings.vehicles.explain") %></p>
  <%= link_to t("settings.vehicles.new"), new_settings_vehicle_path, class: "btn btn--primary" %>
</div>

<div class="card card--flush table-wrap">
  <table>
    <thead>
      <tr>
        <th><%= t("settings.vehicles.name") %></th>
        <th><%= t("settings.vehicles.category") %></th>
        <th class="num"><%= t("settings.vehicles.seats") %></th>
        <th><%= t("settings.vehicles.active") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @vehicles.each do |vehicle| %>
        <tr>
          <td><%= link_to vehicle.label, edit_settings_vehicle_path(vehicle) %></td>
          <td><%= t("vehicle_categories.#{vehicle.category}") %></td>
          <td class="num"><%= vehicle.seats %></td>
          <td><%= vehicle.active? ? "✓" : "—" %></td>
          <td><%= button_to t("settings.delete"), settings_vehicle_path(vehicle), method: :delete, class: "btn btn--sm btn--bad",
                    form: { data: { turbo_confirm: t("settings.vehicles.delete_confirm") } } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
