<% content_for :title, t("admin.new") %>
<h1><%= t("admin.new") %></h1>
<p class="muted"><%= t("admin.new_explain") %></p>

<%= form_with model: @tenant, url: admin_tenants_path, method: :post do |f| %>
  <%= form_errors(@errors) if @errors %>
  <div class="grid grid--2">
    <div class="card">
      <h2><%= t("admin.sections.firm") %></h2>
      <%= render "tenant_fields", f: f %>
    </div>
    <div class="stack">
      <div class="card">
        <h2><%= t("admin.sections.owner") %></h2>
        <%= fields_for :owner, @owner do |o| %>
          <div class="field"><%= o.label :name, t("admin.owner_name") %><%= o.text_field :name, required: true %></div>
          <div class="field"><%= o.label :email_address, t("admin.owner_email") %><%= o.email_field :email_address, required: true %></div>
          <div class="field"><%= o.label :phone, t("admin.owner_phone") %><%= o.telephone_field :phone %></div>
          <div class="field">
            <%= o.label :password, t("admin.owner_password") %><%= o.password_field :password, required: true, minlength: 10, autocomplete: "new-password" %>
            <p class="field-hint"><%= t("admin.owner_password_hint") %></p>
          </div>
        <% end %>
      </div>
      <div class="card">
        <h2><%= t("admin.sections.region") %></h2>
        <%= label_tag :region, t("admin.region") %>
        <%= select_tag :region, options_for_select([ [ t("admin.no_region"), "" ] ] + TenantOnboarding.regions.map { |r| [ r.titleize, r ] }, @region) %>
        <p class="field-hint"><%= t("admin.region_hint") %></p>
      </div>
    </div>
  </div>
  <p style="margin-top: 16px;"><%= f.submit t("admin.create"), class: "btn btn--primary btn--lg" %></p>
<% end %>
