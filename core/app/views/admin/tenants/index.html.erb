<% content_for :title, t("admin.title") %>

<div class="page-head">
  <h1><%= t("admin.title") %></h1>
  <%= link_to t("admin.new"), new_admin_tenant_path, class: "btn btn--primary" %>
</div>

<div class="card card--flush table-wrap">
  <table>
    <thead>
      <tr>
        <th><%= t("admin.firm") %></th>
        <th><%= t("admin.status") %></th>
        <th><%= t("admin.voice_number") %></th>
        <th class="num"><%= t("admin.bookings_30d") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @tenants.each do |tenant| %>
        <tr>
          <td><%= link_to tenant.name, admin_tenant_path(tenant) %><br><small class="mono"><%= tenant.slug %></small></td>
          <td><%= t("tenant_statuses.#{tenant.status}") %></td>
          <td class="mono"><%= tenant.voice_number.presence || "—" %></td>
          <td class="num"><%= @booking_counts.fetch(tenant.id, 0) %></td>
          <td class="row">
            <%= link_to t("admin.discovery.nav"), admin_tenant_discovery_path(tenant), class: "btn btn--sm" %>
            <%= button_to t("admin.act_as"), act_as_admin_tenant_path(tenant), class: "btn btn--sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
