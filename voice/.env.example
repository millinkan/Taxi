# Copy to .env for local development (never commit .env). All variables are
# documented in docs/CONFIGURATION.md.
PORT=8080
PUBLIC_BASE_URL=https://your-tunnel.example.com
CORE_API_URL=http://localhost:3000
CORE_PUBLIC_URL=https://your-core-tunnel.example.com
INTERNAL_API_TOKEN=dev-internal-token-0123456789
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VALIDATE_SIGNATURE=true
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
CR_LANGUAGE=de-DE
CR_SECONDARY_LANGUAGE=en-US
# Optional speech settings (Twilio defaults apply when unset):
# CR_TTS_PROVIDER=ElevenLabs
# CR_VOICE=
# CR_TRANSCRIPTION_PROVIDER=Deepgram
# CR_SPEECH_MODEL=
MAX_CALL_SECONDS=600
LOG_LEVEL=info
