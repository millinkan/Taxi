{
  "name": "ridedesk-voice",
  "version": "1.0.0",
  "private": true,
  "description": "AI phone agent for RideDesk taxi firms: Twilio ConversationRelay + Claude, booking through the core API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "simulate": "tsx scripts/simulate-call.ts",
    "check-core": "tsx scripts/check-core.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
